# انسخ الملف ده باسم .env وحط فيه القيم الحقيقية (بس محلياً على جهازك للتجربة).
# على Render، الفاليوهات دي بتتحط من إعدادات Environment Variables مباشرة،
# مش من ملف .env (وملف .env أصلاً متستبعدش على جيت هاب - شوف .gitignore).

# رابط الاتصال بقاعدة بيانات Postgres (من Supabase -> Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=

# قيمة عشوائية طويلة (32+ حرف) لتوقيع توكنات تسجيل الدخول. غيّرها عن القيمة الافتراضية إجبارياً قبل أي استخدام حقيقي.
JWT_SECRET=

# اختياري: كود سري لاسترجاع كلمة مرور المدير لو نسيها. سيبه فاضي لو مش عايز الخاصية دي.
ADMIN_RECOVERY_CODE=
