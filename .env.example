# انسخ الملف ده باسم .env وحط فيه القيم الحقيقية (بس محلياً على جهازك للتجربة).
# على Render أو Vercel، الفاليوهات دي بتتحط من إعدادات Environment Variables
# مباشرة في لوحة التحكم، مش من ملف .env (وملف .env أصلاً متستبعدش على جيت هاب - شوف .gitignore).

# رابط الاتصال بقاعدة بيانات Postgres من Supabase:
# Project Settings -> Database -> Connection string -> URI
#
# لو ناشر على Render (process واحد شغال طول الوقت): استخدم الرابط العادي
# (Session mode / direct connection، بورت 5432).
#
# لو ناشر على Vercel (Serverless): لازم تستخدم رابط "Connection pooling"
# (Transaction mode، بورت 6543) بدل الرابط المباشر - علشان كل طلب ممكن يفتح
# اتصال جديد بقاعدة البيانات، ولو استخدمت الرابط المباشر ممكن توصل بسرعة لحد
# Supabase الأقصى لعدد الاتصالات المفتوحة.
DATABASE_URL=

# قيمة عشوائية طويلة (32+ حرف) لتوقيع توكنات تسجيل الدخول. غيّرها عن القيمة الافتراضية إجبارياً قبل أي استخدام حقيقي.
JWT_SECRET=

# اختياري: كود سري لاسترجاع كلمة مرور المدير لو نسيها. سيبه فاضي لو مش عايز الخاصية دي.
ADMIN_RECOVERY_CODE=
